		"border": {
			"radius": false,
			"color": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			},
			"core/group": {
				"color": {
					"background": true,
					"text": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|papel",
			"text": "var:preset|color|noite"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|nunito-sans",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|azul-escuro"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|fraunces",
					"fontWeight": "500",
					"lineHeight": "1.08"
				},
				"color": {
					"text": "var:preset|color|noite"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|azul",
					"text": "var:preset|color|noite"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|nunito-sans",
					"fontWeight": "700",
					"fontSize": "1rem",
					"lineHeight": "1.2"
				},
				"border": {
					"radius": "6px",
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|noite"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "22px",
						"right": "22px"
					}
				}
			}
		}
