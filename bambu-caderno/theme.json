	"templateParts": [
		{
			"name": "barra-topo",
			"title": "Barra superior",
			"area": "uncategorized"
		},
		{
			"name": "header",
			"title": "Cabeçalho",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Rodapé",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "pagina-livre",
			"title": "Página livre (sem título, largura total)",
			"postTypes": [
				"page"
			]
		}
	]
